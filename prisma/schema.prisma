
// Prisma schema for AI CV Generator SaaS
// Database: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  email      String   @unique
  name       String?
  avatarUrl  String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cvs          CV[]
  subscription Subscription?
  settings     UserSettings?
  jobMatches   JobMatch[]

  @@map("users")
}

model CV {
  id     String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  template CVTemplate @default(BASIC)
  status   CVStatus   @default(DRAFT)

  // Personal information
  name      String
  photoUrl  String?
  jobTitle  String
  email     String?
  phone     String?
  location  String?
  website   String?
  linkedin  String?
  github    String?
  portfolio String?

  summary String? @db.Text

  // Structured content
  experience     Json @default("[]")
  education      Json @default("[]")
  skills         Json @default("[]")
  projects       Json @default("[]")
  languages      Json @default("[]")
  certifications Json @default("[]")

  // AI-generated content
  generatedContent String? @db.Text
  atsScore         Int?
  coverLetter      String? @db.Text

  // Metadata
  isPublic  Boolean @default(false)
  viewCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobMatches JobMatch[]

  @@index([userId])
  @@map("cvs")
}

model Subscription {
  id     String @id @default(cuid())

  userId String @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Legacy Stripe fields — retained for historical data, no longer written to.
  stripeCustomerId       String? @unique
  stripeSubscriptionId   String? @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  // Paddle fields — current billing provider.
  paddleCustomerId       String? @unique
  paddleSubscriptionId   String? @unique
  paddlePriceId          String?
  paddleCurrentPeriodEnd DateTime?

  premiumPassEnd         DateTime?

  plan   SubscriptionPlan   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model JobMatch {
  id     String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  cvId String
  cv   CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  jobTitle       String?
  companyName    String?
  jobDescription String  @db.Text
  lang           String  @default("en")

  score           Int
  skillsScore     Int
  experienceScore Int
  keywordsScore   Int
  educationScore  Int
  languagesScore  Int

  matchingSkills   Json @default("[]")
  missingSkills    Json @default("[]")
  matchingKeywords Json @default("[]")
  missingKeywords  Json @default("[]")
  recommendations  Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([cvId])
  @@map("job_matches")
}

model UserSettings {
  id     String @id @default(cuid())

  userId String @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // CV Settings
  cvLanguage String @default("fr")
  cvFont     String @default("Inter")
  cvColor    String @default("#111827")
  cvFormat   String @default("A4")

  showSummary   Boolean @default(true)
  showProjects  Boolean @default(true)
  showSkills    Boolean @default(true)
  showInterests Boolean @default(false)

  // AI Settings
  aiTone     String @default("professional")
  aiLength   String @default("medium")
  aiLanguage String @default("fr")
  aiStyle    String @default("corporate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

enum CVTemplate {
  BASIC
  MODERN
  EXECUTIVE
  CREATIVE
  MINIMAL
  ELEGANT
  TECH
  CORPORATE
  SLATE
  WARM
  SOFT
  PHOTO
  CLASSIC
  CRISP
  ADMINISTRATIVE_DIGITAL
}

enum CVStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  PAUSED
}